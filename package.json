{
  "name": "parulgupta1004.github.io",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "deploy": "gh workflow run daily-pypi-stats.yml --ref master",
    "test": "vitest run",
    "postbuild": "node scripts/prerender.mjs",
    "refresh:stats": "node scripts/update-pypi-stats.cjs",
    "test:stats": "node --test scripts/update-pypi-stats.test.cjs",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "check:dependencies": "node scripts/check-dependencies.cjs",
    "test:seo": "node --test scripts/crawler-artifacts.test.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
